# BeatMate audio workspace. Start in offline Mock mode.
# Copy to .env; existing process environment variables take precedence.
BEATMATE_AUDIO_PROVIDER=mock
BEATMATE_AUDIO_LIVE=0
BEATMATE_AUDIO_MAX_CANDIDATES=1
# Local lifetime request limit; song + stems reserves 2 calls for one candidate.
# A saved limit in Settings overrides this initial value.
BEATMATE_AUDIO_MAX_SUBMISSIONS=10

# Real generation: set provider=mureka, live=1, and explicitly select your model.
MUREKA_API_KEY=
MUREKA_MODEL=
MUREKA_BASE_URL=https://api.mureka.ai
MUREKA_DOWNLOAD_HOSTS=cdn.mureka.ai

# Optional trusted CA configuration; TLS verification remains enabled.
# SSL_CERT_FILE=/etc/ssl/cert.pem

# Optional native MIDI Planner: config/native-midi.env.example
