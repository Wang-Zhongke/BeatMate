# Audio CLI auto-loads audio/SSL keys from project .env; explicit env vars override.
# Native MIDI Planner still reads process environment. start.command saves its API key once.
# Explicit --planner overrides BEATMATE_PLANNER. demo always uses offline Mock.
BEATMATE_PLANNER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Only needed if you explicitly select openai; independent of DeepSeek.
OPENAI_API_KEY=
BEATMATE_MODEL=

# Independent Audio MVP. Direct music/song+stems need no text-model key.
# Both current audio workflows call Mureka directly; no lyric analysis step.
BEATMATE_AUDIO_PROVIDER=mock
BEATMATE_AUDIO_PROMPT_MODE=direct
BEATMATE_AUDIO_LIVE=0
BEATMATE_AUDIO_MAX_CANDIDATES=1
# Initial/fallback total Mureka request limit (positive integer, e.g. 1000). Includes reserved stem calls.
# Song+stems reserves 1 generation + n separations. Saved page/CLI budget takes priority.
# Change later via the page or audio-budget --limit; no export/restart required.
BEATMATE_AUDIO_MAX_SUBMISSIONS=10
MUREKA_API_KEY=
MUREKA_BASE_URL=https://api.mureka.ai
# Explicit required in real mode: mureka-7.6 / mureka-8 / mureka-9 / mureka-9.5
MUREKA_MODEL=
# Exact trusted public HTTPS download hosts. No wildcards or private networks.
# Confirm actual official CDN host if your account returns another domain.
MUREKA_DOWNLOAD_HOSTS=cdn.mureka.ai

# Optional on macOS if this Python lacks a default CA bundle (TLS verification stays on):
# SSL_CERT_FILE=/etc/ssl/cert.pem
